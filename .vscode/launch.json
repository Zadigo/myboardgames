{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Minimal Go",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "cwd": "${workspaceFolder}/services/minimalgo",
            "program": "${workspaceFolder}/services/minimalgo/main.go",
            "envFile": "${workspaceFolder}/services/minimalgo/.env",
            "presentation": {
                "hidden": false,
                "group": "Go",
                "order": 1
            }
        },
        {
            "name": "Minimal Game",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "cwd": "${workspaceFolder}/services/minimalgame",
            "program": "${workspaceFolder}/services/minimalgame/main.go",
            "envFile": "${workspaceFolder}/services/minimalgame/.env",
            "presentation": {
                "hidden": false,
                "group": "Go",
                "order": 1
            }
        },
        {
            "name": "Go File",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}",
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Nuxt: Mainsite (Client)",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontends/mainsite/app",
            "presentation": {
                "hidden": false,
                "group": "Nuxt",
                "order": 1
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Nuxt: Mainsite (Server)",
            "outputCapture": "std",
            "cwd": "${workspaceFolder}/frontends/mainsite",
            "program": "${workspaceFolder}/frontends/mainsite/node_modules/nuxt/bin/nuxt.mjs",
            "envFile": "${workspaceFolder}/frontends/mainsite/.env",
            "args": [
                "dev"
            ],
            "presentation": {
                "hidden": false,
                "group": "Nuxt",
                "order": 2
            }
        }
    ],
    "compounds": [
        {
            "name": "Minimal Game Server",
            "configurations": [
                "Minimal Go",
                "Minimal Game"
            ],
            // "preLaunchTask": "GoPurchase",
            "presentation": {
                "hidden": false,
                "group": "Go",
                "order": 1
            }
        },
        {
            "name": "Nuxt Full-Site",
            "configurations": [
                "Nuxt: Mainsite (Client)",
                "Nuxt: Mainsite (Server)"
            ],
            "preLaunchTask": "GoPurchase",
            "presentation": {
                "hidden": false,
                "group": "Nuxt",
                "order": 3
            }
        }
    ]
}
